{
	"version": "0.2.0",
	// List of configurations. Add new configurations or edit existing ones.
	"configurations": [
		{
			"name": "Launch Client",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--extensionDevelopmentPath=${workspaceRoot}/client",
				"${input:ci3ProjectPath}"
			],
			"stopOnEntry": false,
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/client/out/**/*.js",
				"${workspaceFolder}/client/server/**/*.js"
			],
			"preLaunchTask": "compile"
		},
		{
			"name": "Attach to Server",
			"type": "node",
			"request": "attach",
			"port": 6011,
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/client/server/**/*.js"
			]
		}
	],
	"inputs": [
		{
			"id": "ci3ProjectPath",
			"type": "promptString",
			"description": "Absolute path to the CodeIgniter 3 project used to test the extension"
		}
	]
}
